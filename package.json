{
  "name": "popcase",
  "version": "0.1.0",
  "description": "A native EmDash image viewer powered by Yet Another React Lightbox.",
  "type": "module",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./astro": "./src/astro/index.ts",
    "./middleware": "./src/middleware.js"
  },
  "files": ["index.js", "index.d.ts", "src", "README.md"],
  "sideEffects": ["**/*.css", "**/*.astro", "**/bootstrap.ts"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "astro check --minimumFailingSeverity warning"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "emdash": "^1.3.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
