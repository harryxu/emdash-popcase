{
  "name": "emdash-popcase",
  "version": "0.2.0",
  "description": "A native EmDash image viewer powered by Yet Another React Lightbox.",
  "license": "MIT",
  "keywords": [
    "emdash",
    "astro",
    "plugin",
    "lightbox",
    "image-viewer"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "exports": {
    "./exif": {
      "types": "./dist/exif/index.d.ts",
      "import": "./dist/exif/index.js"
    },
    "./exif.css": "./src/exif/exif.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": "./src/astro/index.ts",
    "./admin": "./src/admin/index.tsx",
    "./client": "./src/client/bootstrap.ts",
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.astro",
    "**/bootstrap.ts"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm build && pnpm --dir example dev",
    "build": "tsc -p tsconfig.build.json",
    "build:example": "pnpm build && pnpm --dir example build",
    "test": "pnpm build && node --test test/*.test.ts",
    "test:package": "pnpm build && node test/verify-package.ts",
    "typecheck": "pnpm build && astro check --minimumFailingSeverity warning",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm test:package"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.6.0",
    "exifreader": "^4.51.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.61.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "astro": "^7.0.0",
    "emdash": "^1.3.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro": "^7.3.2",
    "emdash": "^1.3.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryxu/emdash-popcase.git"
  },
  "homepage": "https://github.com/harryxu/emdash-popcase#readme",
  "bugs": {
    "url": "https://github.com/harryxu/emdash-popcase/issues"
  }
}
