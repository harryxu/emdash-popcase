{
  "name": "emdash-popcase",
  "version": "0.1.0",
  "description": "A native EmDash image viewer powered by Yet Another React Lightbox.",
  "license": "MIT",
  "keywords": ["emdash", "astro", "plugin", "lightbox", "image-viewer"],
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./astro": "./src/astro/index.ts",
    "./middleware": "./src/middleware.js"
  },
  "files": ["index.js", "index.d.ts", "src", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css", "**/*.astro", "**/bootstrap.ts"],
  "scripts": {
    "dev": "pnpm --dir example dev",
    "build": "pnpm --dir example build",
    "test": "node --test test/*.test.js",
    "test:package": "node test/verify-package.mjs",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm test:package"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "astro": "^7.0.0",
    "emdash": "^1.3.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.2",
    "emdash": "^1.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
