{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": ["astro/client", "node"]
  },
  "include": ["src", "test", "scripts", "example/astro.config.ts"],
  "exclude": ["dist", "node_modules", "example/dist", "example/node_modules"]
}
